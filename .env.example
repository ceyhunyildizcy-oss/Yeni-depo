# Bu dosyayı ".env.local" adıyla kopyala ve kendi anahtarlarını yaz.
# .env.local dosyası .gitignore'da — GitHub'a yüklenmez.
#
#   cp .env.example .env.local
#
# Sadece kullanacağın sağlayıcının anahtarını doldurman yeterli.
# Boş bıraktığın sağlayıcı arayüzde "anahtar yok" olarak görünür.

# Claude  -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ChatGPT -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini  -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=
