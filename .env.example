# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
PORT=3000

# Videonun disaridan erisilebilecegi ADRES. Instagram videoyu senin sunucundan
# CEKTIGI icin burasi mutlaka internete acik https bir adres olmali.
# Lokalde denerken: `cloudflared tunnel --url http://localhost:3000` calistirip
# cikan https adresini buraya yaz.
PUBLIC_BASE_URL=https://senin-adresin.trycloudflare.com

# Paneli acan tek kisi sensin; basit bir parola korumasi.
APP_PASSWORD=degistir-beni

# ---------------------------------------------------------------------------
# Instagram (Meta / Facebook Login for Business)
# developers.facebook.com > uygulama olustur > "Instagram" urununu ekle
# Gecerli OAuth yonlendirme URI: {PUBLIC_BASE_URL}/auth/instagram/callback
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# TikTok (TikTok for Developers > Content Posting API)
# Redirect URI: {PUBLIC_BASE_URL}/auth/tiktok/callback
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
